assName=\"text-blue-500\" size={14}/> Monitor de Resonancia AEA-97.5\n          </h3>\n          <div className=\"h-64\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <LineChart data={telemetry}>\n                <YAxis domain={[96.9, 97.2]} hide />\n                <Line type=\"monotone\" dataKey=\"val\" stroke=\"#3b82f6\" strokeWidth={2} dot={false} />\n              </LineChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Teclado Dinamo */}\n        <div className=\"bg-slate-900/40 p-6 rounded-2xl border border-white/5 flex flex-col gap-4\">\n          <h3 className=\"text-xs uppercase font-bold text-white flex items-center gap-2\">\n            <Lock className=\"text-emerald-500\" size={14}/> Teclado Dinamo (Cantor-Style)\n          </h3>\n          <div className=\"grid grid-cols-5 gap-2\">\n            {dinamoKey.map((val, i) => (\n              <button key={i} className=\"h-12 bg-black border border-slate-700 rounded-lg hover:border-blue-500 transition-all flex items-center justify-center font-bold text-slate-400\">\n                {val}\n              </button>\n            ))}\n          </div>\n          <p className=\"text-[10px] text-slate-600 mt-4 leading-relaxed\">\n            La secuencia lógica se transfiere de forma transfinita. Presione según el axioma de desplazamiento actual.\n          </p>\n        </div>\n      </div>\n\n      {/* Auditoría */}\n      <div className=\"mt-6 bg-black/40 p-6 rounded-2xl border border-white/5\">\n        <h3 className=\"text-[10px] uppercase font-bold text-slate-500 mb-4 flex items-center gap-2\">\n          <Terminal size={14} /> Log de Auditoría // Sistema Cerrado\n        </h3>\n        <div className=\"h-32 overflow-y-auto text-[10px] text-emerald-600 font-mono space-y-1\">\n          {logs.map((log, i) => <div key={i}>{log}</div>)}\n        </div>\n      </div>\n    </div>\n  );\n}

